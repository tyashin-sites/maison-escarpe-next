# Local dev only — production values come from Tyashin via the deploy workflow.
TYASHIN_API_URL=https://website-api.tyashin.com
TYASHIN_STOREFRONT_URL=https://website-api.tyashin.com/api/v1/public/ecommerce
PROJECT_ID=6ab98d8af53db5cdd5d093f3
PROJECT_SLUG=escarpe-website
BRAND_KIT_CSS_URL=https://website-api.tyashin.com/brand-kit.css
ROBOTS_NOINDEX=true
# Canonical host once the customer's domain is live (e.g. maisonescarpe.com).
# Empty = the slug subdomain.
SITE_DOMAIN=

# The public storefront API key. Public by design (it's the X-API-Key sent from
# the browser), but loaded via env so we don't hardcode it in source.
TYASHIN_API_KEY=ak_REPLACE_ME
